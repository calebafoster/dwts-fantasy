# Install on the orangepi:
#   sudo cp deploy/dwts-fantasy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dwts-fantasy

[Unit]
Description=DWTS Fantasy (gunicorn)
After=network.target

[Service]
User=caleb
Group=caleb
WorkingDirectory=/home/caleb/Projects/dwts-fantasy
ExecStart=/home/caleb/Projects/dwts-fantasy/.venv/bin/gunicorn -b 127.0.0.1:9902 -w 3 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
